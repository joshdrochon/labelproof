# Working documents — internal, not part of the submission
# TICKETS.md is tracked: DEL-7 requires the execution plan to ship with the PRD.
JUDGMENT-LOG.md
BUILD.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
*.egg-info/

# Node / web
node_modules/
# ...and as a plain entry, because the trailing slash matches a DIRECTORY only. A worktree
# that symlinks node_modules to a sibling checkout creates a *link*, which slipped past
# the pattern above and was committed by a `git add -A`.
node_modules
web/dist/
web/.vite/

# Environment and secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Runtime artifacts (ephemeral by design — SEC-2)
uploads/
results/
jobs.db
*.sqlite3

# Eval and test output
eval/out/
playwright-report/
test-results/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Spike scratch output (LP-331) — regenerated on demand, never a fixture of record.
fixtures/spike/

# Runtime storage — uploads, results, batch jobs. Never committed.
.data/
