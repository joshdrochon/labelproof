# LabelProof configuration. Copy to .env for local development.
# Every variable the app reads is listed here (LP-011).

# --- provider ---------------------------------------------------------------------
# Required unless LABELPROOF_FAKE_PROVIDER=1.
ANTHROPIC_API_KEY=

# Run entirely against recorded fixtures — no network, no spend. What CI uses.
LABELPROOF_FAKE_PROVIDER=0

# Extraction runs on the high-resolution vision tier; Tier-3 adjudication is text-only
# and runs on the faster model. See BUILD.md §1 and LP-329's model sweep.
LABELPROOF_EXTRACTION_MODEL=claude-opus-5
LABELPROOF_ADJUDICATION_MODEL=claude-haiku-4-5
LABELPROOF_EFFORT=low

# --- latency budget (PERF-1: p95 <= 5s) -------------------------------------------
LABELPROOF_REQUEST_BUDGET_MS=5000
LABELPROOF_PROVIDER_TIMEOUT_MS=4000
# Below this much remaining budget, Tier 3 is skipped and the field returns Needs review
# rather than blowing the deadline (LP-222).
LABELPROOF_ADJUDICATION_RESERVE_MS=1200

# --- uploads ----------------------------------------------------------------------
LABELPROOF_MAX_IMAGE_BYTES=10485760
LABELPROOF_MAX_IMAGES=4
LABELPROOF_MAX_PDF_PAGES=5
# Do not lower below 1568 — it drops out of the high-resolution vision tier.
LABELPROOF_TARGET_LONG_EDGE_PX=2576

# --- retention and abuse (SEC-2, SEC-9) -------------------------------------------
LABELPROOF_RETENTION_HOURS=24
LABELPROOF_RATE_LIMIT_PER_MINUTE=30

# --- batch ------------------------------------------------------------------------
# Starting value; the real number comes from LP-164 measured against provider limits.
LABELPROOF_BATCH_WORKERS=6

LABELPROOF_STORAGE_DIR=./.data
LABELPROOF_LOG_LEVEL=INFO
