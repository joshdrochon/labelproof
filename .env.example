# LabelProof configuration. Copy to .env for local development.
# Every variable the app reads is listed here (LP-011).

# --- provider ---------------------------------------------------------------------
# Required unless LABELPROOF_FAKE_PROVIDER=1.
ANTHROPIC_API_KEY=

# Run entirely against recorded fixtures — no network, no spend. What CI uses.
LABELPROOF_FAKE_PROVIDER=0

# Extraction runs on the high-resolution vision tier; Tier-3 adjudication is text-only
# and runs on the faster model. See LP-329's model sweep.
LABELPROOF_EXTRACTION_MODEL=claude-sonnet-5
LABELPROOF_ADJUDICATION_MODEL=claude-haiku-4-5
LABELPROOF_EFFORT=low

# --- latency budget ---------------------------------------------------------------
#
# LEAVE THESE UNSET unless you have a reason. Both default from the extraction model's
# MEASURED latency (api/config.py, LP-330), so changing the model cannot leave behind a
# budget the model is unable to meet.
#
# Setting them by hand is how the service was once configured to fail every single
# request: a 4000ms timeout against claude-opus-5, whose calls take 9.4-10.1s, returned
# 503 on every verification. Nothing offline caught it because the test suite stubs the
# provider. The config now refuses to start in that state rather than serving errors.
#
# Empty means "derive from the model", which is what you want.
LABELPROOF_REQUEST_BUDGET_MS=
LABELPROOF_PROVIDER_TIMEOUT_MS=

# The p95 the product is HELD to (PERF-1, quoted from a stakeholder as a hard adoption
# gate). Reported, never enforced as a timeout — enforcing it is what caused the 503s.
# When the configured model cannot meet it, startup warns and /ready says so.
LABELPROOF_LATENCY_TARGET_MS=5000
# Below this much remaining budget, Tier 3 is skipped and the field returns Needs review
# rather than blowing the deadline (LP-222).
LABELPROOF_ADJUDICATION_RESERVE_MS=1200

# --- uploads ----------------------------------------------------------------------
LABELPROOF_MAX_IMAGE_BYTES=10485760
LABELPROOF_MAX_IMAGES=4
LABELPROOF_MAX_PDF_PAGES=5
# Do not lower below 1568 — it drops out of the high-resolution vision tier.
LABELPROOF_TARGET_LONG_EDGE_PX=2576

# --- retention and abuse (SEC-2, SEC-9) -------------------------------------------
LABELPROOF_RETENTION_HOURS=24
LABELPROOF_RATE_LIMIT_PER_MINUTE=30

# --- batch ------------------------------------------------------------------------
# Starting value; the real number comes from LP-164 measured against provider limits.
LABELPROOF_BATCH_WORKERS=6

LABELPROOF_STORAGE_DIR=./.data
LABELPROOF_LOG_LEVEL=INFO
