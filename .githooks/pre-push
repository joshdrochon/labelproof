#!/bin/sh
# Refuse to push main. All work ships on a branch and lands via PR.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo "pre-push: BLOCKED — refusing to push to $remote_ref." >&2
            echo "  Push a branch instead:  git push -u origin \$(git branch --show-current)" >&2
            echo "  Override only if you truly mean it:  git push --no-verify" >&2
            exit 1
            ;;
    esac
done
exit 0
