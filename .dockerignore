# Everything the image does not need, excluded at the context boundary rather than
# left to `COPY` discipline (LP-129). A smaller context is a faster build, but the
# reason that matters here is narrower: secrets and test material must not be able to
# reach a published image by accident, and an allowlist of COPY lines is easy to widen
# later without noticing.

# --- secrets -----------------------------------------------------------------------
# There is a real .env in the working tree with a live key. It is gitignored; it is
# excluded here too, because `docker build` reads the working tree, not git.
.env
.env.*
!.env.example
*.pem
*.key

# --- version control and local tooling ---------------------------------------------
.git
.gitignore
.githooks
.github
.claude

# --- python build and cache artifacts ----------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
.coverage
htmlcov/

# --- node ---------------------------------------------------------------------------
# node_modules is rebuilt inside the web build stage from package-lock.json, which is
# what makes the build reproducible from a clean clone. A host node_modules copied in
# would silently substitute the developer's machine for the lockfile.
web/node_modules/
web/dist/
web/.vite/

# --- test and evaluation material ---------------------------------------------------
# The runtime serves the four demo labels and reads their applications out of
# `golden/set.json`; it needs nothing else from these trees. The Dockerfile copies exactly
# those paths, so excluding the rest here means an over-broad COPY fails loudly at build
# time instead of quietly shipping the evaluation harness to production.
tests/
eval/
playwright-report/
test-results/

# `golden/` is excluded EXCEPT the manifest, which is product surface rather than test
# material: `GET /sample` reads the demo applications from it, and a build without it
# answers a reviewer's first click with an error while every health check stays green.
# The photographs and the Tier B manifest stay out — they are evidence about accuracy,
# not something the service serves.
golden/*
!golden/set.json

# --- runtime artifacts (ephemeral by design — SEC-2) --------------------------------
uploads/
results/
jobs.db
*.sqlite3
.data/

# --- documentation and working files -------------------------------------------------
*.md
!README.md
LICENSE

# --- os ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
